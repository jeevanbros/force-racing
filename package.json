{
  "name": "force-racing-revival",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "setup:local": "node worker/setup-local.mjs",
    "test": "node --test tests/backend*.test.js",
    "test:local": "node tests/backend-local.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": { "wrangler": "4.153.0" }
}
